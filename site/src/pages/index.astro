---
import Video from '../components/Video.astro';

const base = import.meta.env.BASE_URL;
const docs = `${base}docs/`;
const github = 'https://github.com/mariovagomarzal/Looper';

const configExample = `# Hold fn: the wheel opens under the pointer
[wheel.profiles.default.actions]
left   = 'move left --window-id wheel'
right  = 'move right --window-id wheel'
up     = 'layout accordion tiles'
down   = { release = 'fullscreen', left-click = 'close' }
center = 'balance-sizes'

# Hold fn-shift: another profile, another color
wheel.triggers.fn-shift = 'workspaces'
[wheel.profiles.workspaces]
accent-color = '#e8a33d'
[wheel.profiles.workspaces.actions]
left  = 'workspace prev'
right = 'workspace next'

# Swipe with three fingers between workspaces
[mode.main.gesture]
swipe-3-left  = 'workspace --wrap-around prev'
swipe-3-right = 'workspace --wrap-around next'`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Looper</title>
		<meta name="description" content="Looper is a tiling window manager for macOS with a radial wheel, trackpad gestures and plain-text configuration." />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<meta property="og:title" content="Looper" />
		<meta property="og:description" content="Tile with your keyboard. Steer with a wheel." />
	</head>
	<body>
		<header class="nav">
			<a class="brand" href={base}>
				<img src={`${base}favicon.svg`} alt="" width="28" height="28" />
				<span>Looper</span>
			</a>
			<nav aria-label="Main">
				<a href={docs}>Docs</a>
				<a class="pill" href={github}>GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<img class="hero-icon" src={`${base}icon-animated.svg`} alt="Looper icon: the ring of the wheel with the macOS window buttons in its center" width="148" height="148" />
				<p class="eyebrow">A tiling window manager for macOS</p>
				<h1>Tile with your keyboard.<br /><span>Steer with a wheel.</span></h1>
				<p class="lead">
					Looper keeps your windows in a tidy tree, moves them with a keystroke, a swipe or a flick of the pointer,
					and shows you where they'll land before they move.
				</p>
				<div class="actions">
					<a class="button primary" href={`${docs}installation/`}>Get started</a>
					<a class="button" href={github}>View on GitHub</a>
				</div>
				<div class="hero-video">
					<Video
						name="hero"
						title="Looper in 20 seconds"
						description="A tour of a real desktop: windows tile as they open, the wheel moves one with a preview, a three-finger swipe changes workspace and the menu bar follows along."
						aspect="16 / 9"
					/>
				</div>
			</section>

			<section class="feature">
				<div class="feature-text">
					<p class="eyebrow">The radial wheel</p>
					<h2>Hold a key. Point. Let go.</h2>
					<p>
						Hold <kbd>fn</kbd> and a glass wheel opens under the pointer. Point in one of eight directions, or at its
						center, and release to run what you bound there: any Looper command, or a shell command.
					</p>
					<ul>
						<li><strong>Previews.</strong> An outline shows where the windows will end up before you let go.</li>
						<li><strong>Profiles.</strong> Add a modifier and the wheel switches profile, color and shape while it's open.</li>
						<li><strong>Variants.</strong> The wheel adapts to the window under it: an accordion, a floating window, an app.</li>
						<li><strong>Clicks.</strong> Finish with a left, right or other click instead of releasing, for three more actions per slot.</li>
					</ul>
					<a class="link" href={`${docs}guides/wheel/`}>Learn the wheel →</a>
				</div>
				<Video
					name="wheel"
					title="The wheel"
					description="Holding fn over a window opens the wheel. The pointer selects left, the preview outlines the left half and the center shows its icon; releasing moves the window there."
				/>
			</section>

			<section class="bento" aria-label="Features">
				<article class="card wide">
					<div>
						<p class="eyebrow">Tree tiling</p>
						<h3>Every window has its place</h3>
						<p>
							Windows tile as they open, in nested horizontal and vertical containers, as tiles or as an accordion.
							Focus, move, resize and join them from the keyboard.
						</p>
						<a class="link" href={`${docs}concepts/tree/`}>The tree →</a>
					</div>
					<Video
						name="tiling"
						title="Tiling from the keyboard"
						description="Opening three windows that tile on their own, moving focus and windows with the keyboard, resizing, and switching a container to an accordion."
					/>
				</article>

				<article class="card">
					<p class="eyebrow">Trackpad gestures</p>
					<h3>Swipe between workspaces</h3>
					<p>Bind three- and four-finger swipes and taps to commands, per mode and with modifiers, like keys.</p>
					<Video
						name="gestures"
						title="Trackpad gestures"
						description="A three-finger swipe changes workspace, a swipe with alt held moves the window, and a four-finger tap toggles the layout."
						
					/>
					<a class="link" href={`${docs}guides/gestures/`}>Gestures →</a>
				</article>

				<article class="card">
					<p class="eyebrow">Spaces and monitors</p>
					<h3>Workspaces that stay put</h3>
					<p>
						Each monitor and each native macOS Space has its own workspaces. Looper reads your Spaces and never
						fights them.
					</p>
					<Video
						name="spaces"
						title="Workspaces per Space and monitor"
						description="Switching native Spaces with Mission Control, each with its own Looper workspaces, and moving a workspace to the other monitor."
						
					/>
					<a class="link" href={`${docs}concepts/workspaces/`}>Workspaces →</a>
				</article>

				<article class="card">
					<p class="eyebrow">Menu bar</p>
					<h3>Yours to design</h3>
					<p>
						Templates with variables, filters and SF Symbols decide what the menu bar shows: the mode, each workspace,
						the focused app.
					</p>
					<div class="menubar-demo" aria-hidden="true">
						<span class="sq filled">1</span><span class="sq">2</span><span class="sep">│</span><span class="sq">3</span>
					</div>
					<code class="snippet">menu-bar.workspace.focused = ':%&#123;workspace&#125;.square.fill:'</code>
					<a class="link" href={`${docs}guides/menu-bar/`}>Menu bar →</a>
				</article>

				<article class="card">
					<p class="eyebrow">Mouse</p>
					<h3>Drag to rearrange</h3>
					<p>Drag a tiled window onto another to swap them. Move and resize floating windows by keyboard too.</p>
					<Video
						name="mouse"
						title="Mouse"
						description="Dragging a tiled window onto another swaps them; a floating window moves and resizes with key bindings."
						
					/>
					<a class="link" href={`${docs}guides/mouse/`}>Mouse →</a>
				</article>

				<article class="card span2">
					<p class="eyebrow">Scriptable</p>
					<h3>A CLI for everything</h3>
					<p>Every action is a command you can bind, chain with <code>&amp;&amp;</code>, <code>||</code> and <code>;</code>, or run from a script.</p>
					<pre class="terminal"><code><span class="prompt">$</span> looper list-windows --focused
<span class="dim">4128 | Ghostty | ~/Projects</span>
<span class="prompt">$</span> looper move left &amp;&amp; looper layout accordion
<span class="prompt">$</span> looper list-workspaces --monitor focused --empty no
<span class="dim">1</span>
<span class="dim">3</span>
<span class="dim">W</span>
<span class="prompt">$</span> looper wheel open workspaces</code></pre>
					<a class="link" href={`${docs}commands/`}>Commands →</a>
				</article>
			</section>

			<section class="config">
				<div class="config-text">
					<p class="eyebrow">Plain-text configuration</p>
					<h2>One file. Everything in it.</h2>
					<p>
						Bindings, the wheel, gestures, gaps, the menu bar and window rules live in one TOML file that reloads
						when you save it. Errors point at the exact key.
					</p>
					<a class="link" href={`${docs}configuration/`}>Configuration reference →</a>
				</div>
				<div class="window">
					<div class="window-bar" aria-hidden="true">
						<i class="r"></i><i class="y"></i><i class="g"></i>
						<span>~/.config/looper/looper.toml</span>
					</div>
					<pre><code>{configExample}</code></pre>
				</div>
			</section>

			<section class="credits">
				<h2>Standing on good shoulders</h2>
				<p>
					Looper is a fork of <a href="https://github.com/nikitabobko/AeroSpace">AeroSpace</a> by Nikita Bobko, and keeps
					its tree-based tiling, commands and configuration. The wheel's design and interaction are modeled on the radial
					menu of <a href="https://github.com/MrKai77/Loop">Loop</a> by Kai Azim, written from scratch.
				</p>
				<div class="actions">
					<a class="button primary" href={`${docs}installation/`}>Install Looper</a>
					<a class="button" href={docs}>Read the docs</a>
				</div>
			</section>
		</main>

		<footer>
			<span>Looper, released under the MIT License</span>
			<nav class="footer-links" aria-label="Footer"><a href={github}>GitHub</a><a href={`${github}/issues`}>Issues</a><a href={docs}>Docs</a></nav>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0e0f13;
		--bg-2: #16181e;
		--card: rgba(255, 255, 255, 0.035);
		--border: rgba(255, 255, 255, 0.08);
		--text: #f2f4f8;
		--muted: #9aa1b2;
		--accent: #3478f6;
		--accent-2: #a3c8ff;
		color-scheme: dark;
	}
	@media (prefers-color-scheme: light) {
		:root {
			--bg: #f7f8fb;
			--bg-2: #eef1f6;
			--card: rgba(255, 255, 255, 0.75);
			--border: rgba(16, 22, 42, 0.09);
			--text: #10162a;
			--muted: #5b6478;
			--accent: #2f6ae0;
			--accent-2: #143f91;
			color-scheme: light;
		}
	}
	* {
		box-sizing: border-box;
	}
	html {
		background: var(--bg);
	}
	body {
		margin: 0;
		color: var(--text);
		background:
			radial-gradient(1100px 600px at 50% -10%, rgba(52, 120, 246, 0.16), transparent 70%),
			var(--bg);
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		line-height: 1.55;
	}
	a {
		color: var(--accent-2);
	}
	@media (prefers-color-scheme: light) {
		a {
			color: var(--accent);
		}
	}
	main {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 24px;
	}
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 24px;
		backdrop-filter: saturate(160%) blur(18px);
		-webkit-backdrop-filter: saturate(160%) blur(18px);
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		border-bottom: 1px solid var(--border);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		font-size: 1.1rem;
	}
	.nav nav {
		display: flex;
		align-items: center;
		gap: 22px;
		flex-wrap: wrap;
	}
	.nav nav a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.nav nav a:hover {
		color: var(--text);
	}
	.nav nav a.pill {
		color: var(--text);
		padding: 6px 14px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
	}
	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	@media (prefers-color-scheme: dark) {
		.eyebrow {
			color: var(--accent-2);
		}
	}
	.hero {
		text-align: center;
		padding: 72px 0 40px;
	}
	.hero-icon {
		filter: drop-shadow(0 0 48px rgba(52, 120, 246, 0.55));
		margin-bottom: 24px;
	}
	.hero h1 {
		margin: 0;
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
		font-weight: 800;
	}
	.hero h1 span {
		background: linear-gradient(90deg, #3478f6, #a3c8ff);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.lead {
		max-width: 640px;
		margin: 22px auto 0;
		color: var(--muted);
		font-size: 1.2rem;
	}
	.actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 30px;
	}
	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 22px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}
	.button.primary {
		background: linear-gradient(180deg, #4b8cf7, #2f6ae0);
		border-color: transparent;
		color: #ffffff;
		box-shadow: 0 10px 30px -10px rgba(52, 120, 246, 0.7);
	}
	.hero-video {
		max-width: 980px;
		margin: 56px auto 0;
	}
	h2 {
		margin: 0 0 14px;
		font-size: clamp(1.9rem, 4vw, 2.7rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
	}
	h3 {
		margin: 0 0 8px;
		font-size: 1.35rem;
		letter-spacing: -0.015em;
	}
	.feature {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: 48px;
		align-items: center;
		padding: 80px 0;
	}
	.feature p,
	.feature li,
	.config p,
	.card p {
		color: var(--muted);
	}
	.feature ul {
		padding-left: 1.1rem;
		margin: 18px 0;
	}
	.feature li {
		margin: 8px 0;
	}
	.feature li strong {
		color: var(--text);
	}
	kbd {
		font-family: inherit;
		font-size: 0.85em;
		padding: 2px 7px;
		border-radius: 6px;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--text);
	}
	.card .link {
		margin-top: auto;
		align-self: flex-start;
		padding-top: 10px;
	}
	.link {
		display: inline-block;
		margin-top: 6px;
		font-weight: 600;
		text-decoration: none;
	}
	.bento {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		padding: 20px 0 80px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 26px;
		border-radius: 22px;
		border: 1px solid var(--border);
		background: var(--card);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}
	.card.wide {
		grid-column: span 3;
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
		gap: 36px;
		align-items: center;
	}
	.card.span2 {
		grid-column: span 2;
	}
	.card .looper-video {
		margin: 14px 0 6px;
	}
	.menubar-demo {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 16px 0 12px;
		padding: 10px 14px;
		border-radius: 12px;
		background: rgba(0, 0, 0, 0.35);
		color: #ffffff;
		font-weight: 700;
		width: fit-content;
	}
	.menubar-demo .sq {
		display: inline-grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 6px;
		border: 2px solid #ffffff;
		font-size: 0.8rem;
	}
	.menubar-demo .sq.filled {
		background: #ffffff;
		color: #111111;
	}
	.menubar-demo .sep {
		opacity: 0.8;
	}
	.snippet,
	.card code {
		font-family: 'SF Mono', ui-monospace, Menlo, monospace;
		font-size: 0.8rem;
	}
	.snippet {
		display: block;
		margin-bottom: 10px;
		padding: 10px 12px;
		border-radius: 10px;
		background: rgba(0, 0, 0, 0.25);
		color: var(--text);
		overflow-wrap: anywhere;
	}
	.terminal {
		flex: 1;
		margin: 14px 0 10px;
		padding: 14px 16px;
		border-radius: 12px;
		background: #0b0c10;
		color: #e6e8ee;
		font-family: 'SF Mono', ui-monospace, Menlo, monospace;
		font-size: 0.8rem;
		line-height: 1.7;
		overflow-x: auto;
	}
	.terminal .prompt {
		color: #28c840;
	}
	.terminal .dim {
		color: #8f97aa;
	}
	.config {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
		gap: 48px;
		align-items: center;
		padding: 40px 0 90px;
	}
	.window {
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--border);
		background: #0b0c10;
		box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.7);
	}
	.window-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 14px;
		background: #1a1c22;
		color: #8f97aa;
		font-size: 0.8rem;
	}
	.window-bar i {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}
	.window-bar .r {
		background: #ff5f57;
	}
	.window-bar .y {
		background: #febc2e;
	}
	.window-bar .g {
		background: #28c840;
	}
	.window-bar span {
		margin-left: 10px;
	}
	.window pre {
		margin: 0;
		padding: 18px 20px;
		color: #d6dcea;
		font-family: 'SF Mono', ui-monospace, Menlo, monospace;
		font-size: 0.82rem;
		line-height: 1.65;
		overflow-x: auto;
	}
	.credits {
		text-align: center;
		max-width: 760px;
		margin: 0 auto;
		padding: 40px 0 100px;
	}
	.credits p {
		color: var(--muted);
		font-size: 1.1rem;
	}
	footer {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		max-width: 1120px;
		margin: 0 auto;
		padding: 28px 24px 40px;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}
	footer a {
		color: var(--muted);
	}
	.footer-links {
		display: flex;
		gap: 18px;
	}
	@media (max-width: 860px) {
		.feature,
		.config,
		.card.wide {
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
		}
		.bento {
			grid-template-columns: minmax(0, 1fr);
		}
		.card.wide,
		.card.span2 {
			grid-column: auto;
		}
	}
	@media (min-width: 861px) and (max-width: 1060px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.card.wide {
			grid-column: span 2;
		}
	}

	/* Interactions */
	.button,
	.card,
	.link,
	.nav nav a,
	.brand img,
	.hero-icon {
		transition:
			transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.22s ease,
			background 0.22s ease,
			border-color 0.22s ease,
			color 0.18s ease,
			filter 0.22s ease;
	}
	.button:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
		background: color-mix(in srgb, var(--accent) 10%, var(--card));
	}
	.button.primary:hover {
		background: linear-gradient(180deg, #5c98fa, #3a74ea);
		box-shadow: 0 16px 36px -10px rgba(52, 120, 246, 0.85);
	}
	.button:active {
		transform: translateY(0) scale(0.97);
		transition-duration: 0.08s;
	}
	.button:focus-visible,
	.link:focus-visible,
	.nav a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
		box-shadow: 0 24px 50px -28px rgba(52, 120, 246, 0.55);
	}
	.link:hover {
		transform: translateX(4px);
	}
	.nav nav a.pill:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
		background: color-mix(in srgb, var(--accent) 12%, var(--card));
	}
	.brand:hover img {
		transform: rotate(-12deg) scale(1.06);
	}
	.hero-icon:hover {
		transform: scale(1.05);
		filter: drop-shadow(0 0 64px rgba(52, 120, 246, 0.75));
	}
	@media (prefers-reduced-motion: reduce) {
		.button,
		.card,
		.link,
		.nav nav a,
		.brand img,
		.hero-icon {
