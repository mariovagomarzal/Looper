---
// A looping, muted recording from public/videos/<name>.mp4.

interface Props {
	name: string;
	/** What the recording shows, for screen readers */
	description: string;
	/** Width / height */
	aspect?: string;
}

const { name, description, aspect = '16 / 10' } = Astro.props;
const src = `${import.meta.env.BASE_URL}videos/${name}.mp4`;
---

<figure class="looper-video not-content" style={`aspect-ratio: ${aspect}`}>
	<video src={src} autoplay muted loop playsinline aria-label={description} />
</figure>

<style>
	.looper-video {
		container-type: inline-size;
		margin: 1.5rem 0;
		width: 100%;
		border-radius: 14px;
		overflow: hidden;
		background: #15171d;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.6);
	}
	video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
